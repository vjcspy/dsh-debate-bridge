{
  "name": "dsh-debate-bridge",
  "version": "0.2.0",
  "description": "dsh plugin: debate bridge and arena. The host half registers four loopback-only HTTP routes on the running `dsh web` host and creates, attaches, permission-presets, titles and prompts the Opponent Session IN PROCESS, so the Session lands in the same SessionStore the Web GUI reads and appears live with no refresh; it also exposes the edge-derived idle signal the debate server's `dsh` provider needs and observes `aw debate create` tool results to link a Proposer debate to the Session that created it. The browser half adds a Debate Arena page tab to the core right sidebar and reads debates through three admission-fenced `/api` routes.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "private": true,
  "keywords": [
    "dsh",
    "dsh-plugin",
    "debate",
    "opponent",
    "session",
    "webserver",
    "bridge",
    "sidebar",
    "arena"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && tsdown --config tsdown.config.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run build && vitest run",
    "test:unit": "vitest run test/unit",
    "test:composition": "vitest run test/composition"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
